{
  "mcpServers": {
    "paper": {
      "type": "http",
      "url": "$PAPER_MCP_URL",
      "path_mapping": "virtual_to_physical",
      "path_arg_names": [
        "source_docx_path",
        "template_docx_path",
        "output_json_path",
        "output_docx_path",
        "rules_json_path",
        "section_chunk_json_path",
        "section_results_json_path",
        "final_docx_path",
        "report_json_path",
        "result_json_path"
      ],
      "description": "Template-constrained paper pipeline through the remote paper MCP HTTP service",
      "enabled": true
    }
  },
  "skills": {
    "paper-format-expert": {
      "enabled": true
    }
  }
}
