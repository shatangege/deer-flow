# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key
# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Enable LangSmith to monitor and debug your LLM calls, agent runs, and tool executions.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# GitHub API Token
# GITHUB_TOKEN=your-github-token

# Remote formatter-paper HTTP MCP service URL
# FORMATTER_PAPER_MCP_URL=http://host.docker.internal:8765/mcp
# FORMATTER_PAPER_IMAGE=formatter-paper-mcp:windows-ltsc2022
# FORMATTER_PAPER_PORT=8765
# FORMATTER_PAPER_PUBLIC_BASE_URL=http://host.docker.internal:8765

# ── Docker build mirrors (optional; speeds up `docker compose ... --build`) ──
# Load these from the same .env when building from docker/docker-compose*.yaml.
# Also configure Docker Engine "registry-mirrors" for docker.io / ghcr.io pulls (see Docker Desktop or daemon.json).
#
# Debian apt inside backend image (hostname only, no https://).
# docker-compose-dev.yaml defaults to mirrors.aliyun.com if unset; set explicitly to force official:
# APT_MIRROR=deb.debian.org
# Or use another mirror, e.g. mirrors.tuna.tsinghua.edu.cn
# APT_MIRROR=mirrors.aliyun.com
#
# NodeSource apt repo (mainland-friendly):
# NODESOURCE_BASE_URL=https://mirrors.aliyun.com/deb.nodesource.com
#
# PyPI for uv sync during backend image build:
# UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
#
# pnpm / corepack (frontend image):
# NPM_REGISTRY=https://registry.npmmirror.com
#
# Pull-through image names (DaoCloud-style; adjust to a mirror you trust):
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# DOCKER_CLI_IMAGE=docker.m.daocloud.io/library/docker:cli
#
# ghcr.io uv binary (use host mirror or vendor-specific ghcr proxy if ghcr is slow):
# UV_IMAGE=ghcr.io/astral-sh/uv:0.7.20
